# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example with default postgres superuser:
# DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/stocksense
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocksense

# CORS — frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Demo seed credentials (used by seed_demo_data management command)
SEED_ADMIN_EMAIL=admin@stockcontrolsystem.com
SEED_ADMIN_PASSWORD=admin1234
SEED_MANAGER_EMAIL=manager@stockcontrolsystem.com
SEED_MANAGER_PASSWORD=manager1234
SEED_STAFF_EMAIL=staff@stockcontrolsystem.com
SEED_STAFF_PASSWORD=staff1234
