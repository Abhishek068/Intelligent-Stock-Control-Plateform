# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocksense

# CORS — frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (console fallback when Brevo key empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@stocksense.local
BREVO_API_KEY=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (local PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stocksense

# CORS — frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (console fallback when Brevo key empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@stocksense.local
BREVO_API_KEY=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set True for local demos without a worker
CELERY_TASK_ALWAYS_EAGER=True

# Firebase push (optional) — absolute path to service account JSON
FIREBASE_CREDENTIALS_PATH=

# Groq chatbot (primary)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI chatbot (fallback — offline keyword mode when both empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# See THIRD_PARTY_INTEGRATIONS.md for setup steps (Brevo, Redis, Firebase, etc.)
